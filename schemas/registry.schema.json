{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registry",
  "description": "Deterministically generated discovery document on main.",
  "type": "object",
  "properties": {
    "widgets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RegistryEntry"
      }
    }
  },
  "required": [
    "widgets"
  ],
  "$defs": {
    "RegistryEntry": {
      "description": "A reviewed package and the exact content displayed before installation.",
      "type": "object",
      "properties": {
        "publishedAt": {
          "description": "First inclusion in the reviewed community catalogue, in UTC RFC3339.",
          "type": "string",
          "format": "date-time"
        },
        "package": {
          "$ref": "#/$defs/PackageManifest"
        },
        "config": {
          "$ref": "#/$defs/WidgetConfig"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileDigest"
          }
        }
      },
      "required": [
        "publishedAt",
        "package",
        "config",
        "files"
      ]
    },
    "PackageManifest": {
      "description": "npm metadata used by aidget. Additional npm fields are retained on disk.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageAuthor"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageRepository"
            },
            {
              "type": "null"
            }
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "PackageAuthor": {
      "description": "npm's author value, retaining its standard string and object forms.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name"
          ]
        }
      ]
    },
    "PackageRepository": {
      "description": "npm's repository field supports both standard forms.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "directory": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "url"
          ]
        }
      ]
    },
    "WidgetConfig": {
      "description": "Portable aidget configuration. Installed revisions are stored by `WidgetMeta`.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "logo": {
          "type": [
            "string",
            "null"
          ]
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WidgetPlatform"
          }
        },
        "size": {
          "$ref": "#/$defs/WidgetSize"
        },
        "dragMode": {
          "$ref": "#/$defs/WidgetDragMode"
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WidgetPermission"
          }
        },
        "network": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "screenshots",
        "platforms",
        "size",
        "dragMode",
        "permissions",
        "network"
      ]
    },
    "WidgetPlatform": {
      "description": "A platform on which the widget has been checked by its author.",
      "type": "string",
      "enum": [
        "macos",
        "windows",
        "linux"
      ]
    },
    "WidgetSize": {
      "description": "Initial logical size; the board remains authoritative after installation.",
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ]
    },
    "WidgetDragMode": {
      "description": "Widget window drag policy; controls remain interactive in either mode.",
      "oneOf": [
        {
          "description": "Drag ordinary widget content, excluding interactive and opted-out regions.",
          "type": "string",
          "const": "all"
        },
        {
          "description": "Drag only the host's top handle.",
          "type": "string",
          "const": "handle"
        }
      ]
    },
    "WidgetPermission": {
      "description": "Capabilities a widget may ask the host for. A widget only gets the ones it\ndeclares in `config.json`; anything else is denied before it leaves Rust.",
      "type": "string",
      "enum": [
        "script",
        "location",
        "storage"
      ]
    },
    "FileDigest": {
      "description": "One immutable file in the npm package, hashed before packing.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "size",
        "sha256"
      ]
    }
  }
}
