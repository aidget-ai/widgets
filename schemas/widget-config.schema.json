{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WidgetConfig",
  "description": "Portable aidget configuration. Installed revisions are stored by `WidgetMeta`.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "logo": {
      "type": [
        "string",
        "null"
      ]
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WidgetPlatform"
      }
    },
    "size": {
      "$ref": "#/$defs/WidgetSize"
    },
    "dragMode": {
      "$ref": "#/$defs/WidgetDragMode"
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WidgetPermission"
      }
    },
    "network": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "screenshots",
    "platforms",
    "size",
    "dragMode",
    "permissions",
    "network"
  ],
  "$defs": {
    "WidgetPlatform": {
      "description": "A platform on which the widget has been checked by its author.",
      "type": "string",
      "enum": [
        "macos",
        "windows",
        "linux"
      ]
    },
    "WidgetSize": {
      "description": "Initial logical size; the board remains authoritative after installation.",
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ]
    },
    "WidgetDragMode": {
      "description": "Widget window drag policy; controls remain interactive in either mode.",
      "oneOf": [
        {
          "description": "Drag ordinary widget content, excluding interactive and opted-out regions.",
          "type": "string",
          "const": "all"
        },
        {
          "description": "Drag only the host's top handle.",
          "type": "string",
          "const": "handle"
        }
      ]
    },
    "WidgetPermission": {
      "description": "Capabilities a widget may ask the host for. A widget only gets the ones it\ndeclares in `config.json`; anything else is denied before it leaves Rust.",
      "type": "string",
      "enum": [
        "script",
        "location",
        "storage"
      ]
    }
  }
}
